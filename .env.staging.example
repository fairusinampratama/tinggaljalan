# Dedicated preview configuration. Fill secrets privately; never commit .env.
APP_NAME="Tinggal Jalan Preview"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://preview.tinggaljalan.com
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u304629909_tj_preview
DB_USERNAME=u304629909_tj_preview
DB_PASSWORD=
DB_URL=

SESSION_DRIVER=file
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=preview.tinggaljalan.com
SESSION_COOKIE=tinggaljalan_preview_session
CACHE_STORE=file
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# No queue worker or scheduler may run until outgoing integrations are reviewed.
# Database settings must also disable email, WhatsApp and payment gateways.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=preview@tinggaljalan.test
MAIL_FROM_NAME="Tinggal Jalan Preview"
GOOGLE_ADS_ID=
GOOGLE_ADS_CONSENT_ENABLED=false
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
